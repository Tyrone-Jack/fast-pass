# Network resilience — proxy or not, retries help
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-timeout=300000

# Prefer the offline store when available
prefer-offline=true

# Keep the store on disk so rebuilds don't re-download
store-dir=.pnpm-store
